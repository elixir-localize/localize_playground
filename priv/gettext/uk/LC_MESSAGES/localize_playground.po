msgstr "\"1ft 3in\" — найвужча комбінація одиниць."

#: lib/localize_playground_web/live/lists_live.ex:19
#, elixir-autogen, icu-format
msgid "\"A, B, and C\" — default conjunctive list (long width)."
msgstr "\"A, B та C\" — сполучний список за замовчуванням (довга ширина)."

#: lib/localize_playground_web/live/lists_live.ex:24
